{
  "id": "ux_04_lobby",
  "requirement": "NET-01",
  "description": "Lobby flow: start is refused until an opponent slot exists and you are ready; then the lobby starts and goes to deck choice.",
  "steps": [
    {"press": "Lobby"},
    {"press": "StartLobby"},
    {"press": "AddAi"},
