  ],
  "expect": [
    {"event": "lobby_created"},
    {"event": "lobby_start_refused"},
    {"event": "lobby_slot_added", "fields": {"slots": 2}},
    {"event": "lobby_ready"},
    {"event": "lobby_started", "fields": {"players": 2}},
    {"event": "screen", "fields": {"name": "deck"}}
  ]
}
